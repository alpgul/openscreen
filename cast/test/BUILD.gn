import("//build/config/rust.gni")
import("//build_overrides/build.gni")
import("../../gni/openscreen.gni")

openscreen_source_set("unittests") {
  testonly = true
  sources = [ "device_auth_test.cc" ]

  deps = [
    "../../platform:test",
    "../../testing/util",
    "../../third_party/googletest:gmock",
    "../../third_party/googletest:gtest",
    "../common:channel",
    "../common:test_helpers",
    "../common/channel/proto:channel_proto",
    "../receiver:channel",
    "../receiver:test_helpers",
    "../sender:channel",
  ]
}

if (is_posix && !build_with_chromium) {
  if (enable_rust) {
    # Rust-driven E2E tests that launch the cast_sender and cast_receiver
    # standalone applications as subprocesses.
    openscreen_rust_static_library("cast_e2e_rust_tests") {
      testonly = true
      is_gtest_unittests = true
      crate_name = "cast_e2e_rust_tests"
      crate_root = "e2e/lib.rs"

      # For sending SIGTERM to the child processes.
      allow_unsafe = true
      sources = [
        "e2e/lib.rs",
        "e2e/runner.rs",
      ]
      deps = [
        "//testing/rust_gtest_interop",
        "//third_party/rust/libc/v0_2:lib",
      ]
      data_deps = [
        "../standalone_receiver:cast_receiver",
        "../standalone_sender:cast_sender",
      ]
    }
  }

  openscreen_source_set("e2e_tests") {
    testonly = true
    sources = [ "cast_socket_e2e_test.cc" ]

    deps = [
      "../../platform",
      "../../platform:standalone_impl",
      "../../testing/util",
      "../../third_party/boringssl",
      "../../third_party/getopt",
      "../../third_party/googletest:gmock",
      "../../third_party/googletest:gtest",
      "../../util",
      "../common:certificate",
      "../common:certificate_boringssl",
      "../common:channel",
      "../common:test_helpers",
      "../receiver:channel",
      "../sender:channel",
    ]
    if (enable_rust) {
      deps += [ ":cast_e2e_rust_tests" ]
    }
  }

  openscreen_executable("make_crl_tests") {
    testonly = true
    sources = [ "make_crl_tests.cc" ]

    deps = [
      "../../platform:test",
      "../../third_party/boringssl",
      "../../util",
      "../common:certificate_boringssl",
      "../common:test_helpers",
      "../common/certificate/proto:certificate_proto",
    ]
  }
}
