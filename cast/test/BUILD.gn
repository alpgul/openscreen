import("//build/config/rust.gni")
import("//build_overrides/build.gni")
import("../../gni/openscreen.gni")
import("../streaming/external_libraries.gni")

openscreen_source_set("unittests") {
  testonly = true
  sources = [ "device_auth_test.cc" ]

  deps = [
    "../../platform:test",
    "../../testing/util",
    "../../third_party/googletest:gmock",
    "../../third_party/googletest:gtest",
    "../common:channel",
    "../common:test_helpers",
    "../common/channel/proto:channel_proto",
    "../receiver:channel",
    "../receiver:test_helpers",
    "../sender:channel",
  ]
}

if (is_posix && !build_with_chromium) {
  if (enable_rust) {
    # Rust-driven E2E tests that launch the cast_sender and cast_receiver
    # standalone applications as subprocesses.
    openscreen_rust_static_library("cast_e2e_rust_tests") {
      testonly = true
      is_gtest_unittests = true
      crate_name = "cast_e2e_rust_tests"
      crate_root = "e2e/lib.rs"

      # For sending SIGTERM to the child processes.
      allow_unsafe = true
      sources = [
        "e2e/lib.rs",
        "e2e/runner.rs",
      ]
      deps = [
        "//testing/rust_gtest_interop",
        "//third_party/rust/libc/v0_2:lib",
      ]
      data_deps = [
        "../standalone_receiver:cast_receiver",
        "../standalone_sender:cast_sender",
      ]

      # The codecs that the cast_sender and cast_receiver binaries can handle
      # depend on the external media libraries they are built with. These
      # cfgs let the tests only run where both binaries handle their codec.
      # The conditions must match ../standalone_sender/BUILD.gn and
      # ../standalone_receiver/BUILD.gn.
      rustflags = []

      # The sender encodes the test video with libvpx, libaom, or FFmpeg,
      # instead of sending synthetic frames.
      if (have_ffmpeg && have_libopus && have_libvpx) {
        rustflags += [ "--cfg=cast_sender_has_external_libs" ]
      }

      # The sender can encode AV1 when it uses the external libraries.
      if (have_libaom) {
        rustflags += [ "--cfg=cast_sender_has_libaom" ]
      }

      # The receiver decodes with FFmpeg and plays with SDL2, instead of
      # discarding the frames.
      if (have_ffmpeg && have_libsdl2) {
        rustflags += [ "--cfg=cast_receiver_has_external_libs" ]
      }
    }
  }

  openscreen_source_set("e2e_tests") {
    testonly = true
    sources = [
      "cast_socket_e2e_test.cc",
      "in_process_streaming_e2e_test.cc",
    ]

    deps = [
      "../../platform",
      "../../platform:standalone_impl",
      "../../testing/util",
      "../../third_party/boringssl",
      "../../third_party/getopt",
      "../../third_party/googletest:gmock",
      "../../third_party/googletest:gtest",
      "../../util",
      "../common:certificate",
      "../common:certificate_boringssl",
      "../common:channel",
      "../common:public",
      "../common:test_helpers",
      "../receiver:channel",
      "../sender:channel",
      "../streaming:common",
      "../streaming:receiver",
      "../streaming:sender",
    ]
    if (enable_rust) {
      deps += [ ":cast_e2e_rust_tests" ]
    }
  }

  openscreen_executable("make_crl_tests") {
    testonly = true
    sources = [ "make_crl_tests.cc" ]

    deps = [
      "../../platform:test",
      "../../third_party/boringssl",
      "../../util",
      "../common:certificate_boringssl",
      "../common:test_helpers",
      "../common/certificate/proto:certificate_proto",
    ]
  }
}
